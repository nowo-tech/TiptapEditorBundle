{#- REQ-DEMO-014: the demo shell is UiKit's admin layout with UiKit's default theme (nowo-ui.css from the bundle's own
    asset package, no CSS framework, no CDN, no inline styles). The light/dark toggle is UiKit's. -#}
{% extends '@NowoUiKit/layout/admin.html.twig' %}

{% block nowo_ui_document_title %}{% block title %}{{ 'demo.title'|trans({}, 'messages') }}{% endblock %}{% endblock %}

{% block nowo_ui_navigation %}
    {% set _locale = app.request.locale %}
    {% set _route = app.request.attributes.get('_route') %}
    <header class="nowo-ui-header" data-testid="demo-masthead">
        <a class="nowo-ui-brand" href="{{ path('app_home', { _locale: _locale }) }}">{{ 'demo.title'|trans({}, 'messages') }}</a>
        <nav class="nowo-ui-menu" aria-label="{{ 'demo.title'|trans({}, 'messages') }}">
            {% for item in [
                {routes: ['app_home'], route: 'app_home', label: 'demo.menu_home'},
                {routes: ['app_demo'], route: 'app_demo', label: 'demo.menu_demo'},
                {routes: ['app_demo_configs'], route: 'app_demo_configs', label: 'demo.menu_configs'},
                {routes: ['app_showcase'], route: 'app_showcase', label: 'demo.menu_showcase'},
                {routes: ['app_examples_index', 'app_examples_show'], route: 'app_examples_index', label: 'demo.menu_examples'},
            ] %}
                <a class="nowo-ui-link" href="{{ path(item.route, { _locale: _locale }) }}"{% if _route in item.routes %} aria-current="page"{% endif %}>{{ item.label|trans({}, 'messages') }}</a>
            {% endfor %}
        </nav>
        <div class="nowo-ui-header__end">
            <a class="nowo-ui-link" href="{{ path('app_home', { _locale: 'en' }) }}"{% if _locale == 'en' %} aria-current="true"{% endif %}>English</a>
            <a class="nowo-ui-link" href="{{ path('app_home', { _locale: 'es' }) }}"{% if _locale == 'es' %} aria-current="true"{% endif %}>Español</a>
            {{ include('@NowoUiKitBundle/partials/_theme_toggle.html.twig', { compact: true }, false) }}
        </div>
    </header>
{% endblock %}

{% block nowo_ui_content %}{% block body %}{% endblock %}{% endblock %}


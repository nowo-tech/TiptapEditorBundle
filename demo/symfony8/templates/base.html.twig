{#- REQ-DEMO-014: the demo runs inside UiKit's shared demo platform shell (@NowoUiKit/demo_platform/layout.html.twig):
    the same top bar, aside, content width, theme and footer as every other nowo-tech bundle demo. This file only
    declares the demo (nowo_ui_demo_platform). -#}
{% extends '@NowoUiKit/demo_platform/layout.html.twig' %}
{% set _locale = app.request.locale %}
{% set nowo_ui_demo_platform = {
    bundle: 'Tiptap Editor',
    home_route: 'app_home',
    home_params: {_locale: _locale},
    repository: 'https://github.com/nowo-tech/TiptapEditorBundle',
    translation_domain: 'messages',
    locales: ['en', 'es'],
    nav: [
        {label: 'demo.menu_home', route: 'app_home', params: {_locale: _locale}},
        {label: 'demo.menu_demo', route: 'app_demo', params: {_locale: _locale}, section: 'demo.nav_editors'},
        {label: 'demo.menu_configs', route: 'app_demo_configs', params: {_locale: _locale}, section: 'demo.nav_editors'},
        {label: 'demo.menu_showcase', route: 'app_showcase', params: {_locale: _locale}, section: 'demo.nav_editors'},
        {label: 'demo.menu_examples', route: 'app_examples_index', params: {_locale: _locale}, active: ['app_examples_index', 'app_examples_show'], section: 'demo.nav_docs'},
    ],
} %}

{% block nowo_ui_document_title %}{% block title %}{{ 'demo.title'|trans({}, 'messages') }}{% endblock %} — Symfony 8{% endblock %}

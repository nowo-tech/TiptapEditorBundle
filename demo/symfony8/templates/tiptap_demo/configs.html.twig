{% extends 'base.html.twig' %}

{% block title %}{{ 'demo.menu_configs'|trans({}, 'messages') }} – {{ 'demo.title'|trans({}, 'messages') }}{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'demo.configs_page_title'|trans({}, 'messages'),
        intro: 'demo.configs_page_lead'|trans({}, 'messages'),
    }) }}
{% endblock %}

{% block body %}
    {{ form_start(form) }}
        {{ form_errors(form) }}
        {% for name in ['full', 'simple', 'notion', 'agent', 'headless'] %}
            <section class="nowo-ui-card">
                <div class="nowo-ui-card__body">
                    <h2 class="nowo-ui-card__title">{{ ('demo.section_' ~ name)|trans({}, 'messages') }}</h2>
                    <p class="nowo-ui-muted">{{ ('demo.section_' ~ name ~ '_hint')|trans({}, 'messages') }}</p>
                    {{ form_row(form['content_' ~ name]) }}
                </div>
            </section>
        {% endfor %}

        {# Each editor above has its own heading and hint (REQ-TWIG-003 rule 3); form_rest renders the submit and the CSRF token. #}
        {{ form_rest(form) }}
    {{ form_end(form, {render_rest: false}) }}

    {% if form.vars.submitted and form.vars.valid %}
        <p class="nowo-ui-muted">{{ 'demo.saved_preview'|trans({}, 'messages') }}</p>
        {% for name in ['content_full', 'content_simple', 'content_notion', 'content_agent', 'content_headless'] %}
            <h3>{{ form[name].vars.label|trans({}, 'messages') }}</h3>
            <pre class="nowo-ui-code-block nowo-ui-code-block--wrap">{{ form[name].vars.data|default('')|e }}</pre>
        {% endfor %}
    {% endif %}

    <script src="{{ asset(nowo_tiptap_editor_asset_path('tiptap-editor.js'), nowo_tiptap_editor_asset_package()) }}"></script>
{% endblock %}

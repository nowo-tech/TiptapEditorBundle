{% extends 'base.html.twig' %}

{% block title %}{{ 'demo.menu_configs'|trans({}, 'messages') }} – {{ 'demo.title'|trans({}, 'messages') }}{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'demo.configs_page_title'|trans({}, 'messages'),
        intro: 'demo.configs_page_lead'|trans({}, 'messages'),
    }) }}
{% endblock %}

{% block body %}
    {# One form card; each editor keeps its own heading and hint (REQ-TWIG-003 rule 3). #}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'demo.menu_configs'|trans({}, 'messages'), kind: 'form', form: form} %}
        {% block section_body %}
            {{ form_start(form, {attr: {id: 'tiptap-configs-form'}}) }}
                {{ form_errors(form) }}
                {% for name in ['full', 'simple', 'notion', 'agent', 'headless'] %}
                    <h3>{{ ('demo.section_' ~ name)|trans({}, 'messages') }}</h3>
                    <p class="nowo-ui-muted">{{ ('demo.section_' ~ name ~ '_hint')|trans({}, 'messages') }}</p>
                    {{ form_row(form['content_' ~ name]) }}
                {% endfor %}
                {% do form.submit.setRendered %}
                {{ form_rest(form) }}
            {{ form_end(form, {render_rest: false}) }}
        {% endblock %}
        {% block section_footer %}
            <button type="submit" form="tiptap-configs-form" class="nowo-ui-btn nowo-ui-btn--primary">{{ form.submit.vars.label|trans({}, 'messages') }}</button>
        {% endblock %}
    {% endembed %}

    {% if form.vars.submitted and form.vars.valid %}
        {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'demo.saved_preview'|trans({}, 'messages'), kind: 'detail', form: form} %}
            {% block section_body %}
                {% for name in ['content_full', 'content_simple', 'content_notion', 'content_agent', 'content_headless'] %}
                    <h3>{{ form[name].vars.label|trans({}, 'messages') }}</h3>
                    <pre class="nowo-ui-code-block nowo-ui-code-block--wrap">{{ form[name].vars.data|default('')|e }}</pre>
                {% endfor %}
            {% endblock %}
        {% endembed %}
    {% endif %}

    <script src="{{ asset(nowo_tiptap_editor_asset_path('tiptap-editor.js'), nowo_tiptap_editor_asset_package()) }}"></script>
{% endblock %}

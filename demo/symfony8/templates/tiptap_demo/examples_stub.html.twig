{% extends 'base.html.twig' %}

{% block title %}{{ ('examples.card.' ~ slug ~ '.title')|trans({}, 'messages') }} – {{ 'examples.page_title'|trans({}, 'messages') }}{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: ('examples.card.' ~ slug ~ '.title')|trans({}, 'messages'),
        intro: ('examples.card.' ~ slug ~ '.desc')|trans({}, 'messages'),
    }) }}
{% endblock %}

{% block body %}
    <nav class="nowo-ui-breadcrumbs" aria-label="breadcrumb">
        <a href="{{ path('app_examples_index', { _locale: app.request.locale }) }}">{{ 'demo.menu_examples'|trans({}, 'messages') }}</a>
    </nav>

    <div class="nowo-ui-flash nowo-ui-flash--info" role="note">{{ 'examples.stub_lead'|trans({}, 'messages') }}</div>

    <p>
        <a class="nowo-ui-btn nowo-ui-btn--primary" href="{{ 'examples.docs_url'|trans({}, 'messages') }}" rel="noopener noreferrer" target="_blank">{{ 'examples.doc_hub_link'|trans({}, 'messages') }}</a>
        <a class="nowo-ui-btn nowo-ui-btn--outline" href="{{ path('app_examples_index', { _locale: app.request.locale }) }}">{{ 'examples.back_index'|trans({}, 'messages') }}</a>
    </p>
{% endblock %}

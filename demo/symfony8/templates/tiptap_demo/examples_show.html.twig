{% extends 'base.html.twig' %}

{% block title %}{{ ('examples.card.' ~ slug ~ '.title')|trans({}, 'messages') }} – {{ 'examples.page_title'|trans({}, 'messages') }}{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: ('examples.card.' ~ slug ~ '.title')|trans({}, 'messages'),
        intro: ('examples.card.' ~ slug ~ '.desc')|trans({}, 'messages'),
    }) }}
{% endblock %}

{% block body %}
    <nav class="nowo-ui-breadcrumbs" aria-label="breadcrumb">
        <a href="{{ path('app_examples_index', { _locale: app.request.locale }) }}">{{ 'demo.menu_examples'|trans({}, 'messages') }}</a>
    </nav>

    {% if slug == 'syntax-highlighting' %}
        {# The code-block theme of the editor's syntax highlighting feature (the bundle's own markup), not the demo's base style. #}
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github-dark.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">
    {% endif %}

    {{ form_start(form) }}
        {{ form_errors(form) }}
        {{ form_rest(form) }}
    {{ form_end(form, {render_rest: false}) }}

    {% if form.vars.submitted and form.vars.valid %}
        <p class="nowo-ui-muted">{{ 'demo.saved_preview'|trans({}, 'messages') }}</p>
        <pre class="nowo-ui-code-block nowo-ui-code-block--wrap">{{ saved_value|default('')|e }}</pre>
    {% endif %}

    <p>
        <a href="{{ 'examples.docs_url'|trans({}, 'messages') }}" rel="noopener noreferrer" target="_blank">{{ 'examples.doc_hub_link'|trans({}, 'messages') }}</a>
        ·
        <a href="{{ path('app_examples_index', { _locale: app.request.locale }) }}">{{ 'examples.back_index'|trans({}, 'messages') }}</a>
    </p>

    <script src="{{ asset(nowo_tiptap_editor_asset_path('tiptap-editor.js'), nowo_tiptap_editor_asset_package()) }}"></script>
{% endblock %}

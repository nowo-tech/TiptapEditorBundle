{% extends 'base.html.twig' %}

{% block title %}{{ ('examples.card.' ~ slug ~ '.title')|trans({}, 'messages') }} – {{ 'examples.page_title'|trans({}, 'messages') }}{% endblock %}

{% block nowo_ui_page_header %}
    {% set _toolbar %}
        <a class="nowo-ui-btn nowo-ui-btn--outline" href="{{ path('app_examples_index', { _locale: app.request.locale }) }}">{{ 'examples.back_index'|trans({}, 'messages') }}</a>
        <a class="nowo-ui-btn nowo-ui-btn--outline" href="{{ 'examples.docs_url'|trans({}, 'messages') }}" rel="noopener noreferrer" target="_blank">{{ 'examples.doc_hub_link'|trans({}, 'messages') }}</a>
    {% endset %}
    {{ include(nowo_ui_partial('page_header'), {
        title: ('examples.card.' ~ slug ~ '.title')|trans({}, 'messages'),
        intro: ('examples.card.' ~ slug ~ '.desc')|trans({}, 'messages'),
        toolbar: _toolbar,
    }) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: ('examples.card.' ~ slug ~ '.title')|trans({}, 'messages'), kind: 'form', form: form} %}
        {% block section_body %}
            {{ form_start(form, {attr: {id: 'tiptap-example-form'}}) }}
                {{ form_errors(form) }}
                {% do form.submit.setRendered %}
                {{ form_rest(form) }}
            {{ form_end(form, {render_rest: false}) }}
        {% endblock %}
        {% block section_footer %}
            <button type="submit" form="tiptap-example-form" class="nowo-ui-btn nowo-ui-btn--primary">{{ form.submit.vars.label|trans({}, 'messages') }}</button>
        {% endblock %}
    {% endembed %}

    {% if form.vars.submitted and form.vars.valid %}
        {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'demo.saved_preview'|trans({}, 'messages'), kind: 'detail', saved_value: saved_value} %}
            {% block section_body %}<pre class="nowo-ui-code-block nowo-ui-code-block--wrap">{{ saved_value|default('')|e }}</pre>{% endblock %}
        {% endembed %}
    {% endif %}

    <script src="{{ asset(nowo_tiptap_editor_asset_path('tiptap-editor.js'), nowo_tiptap_editor_asset_package()) }}"></script>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}{{ 'examples.page_title'|trans({}, 'messages') }} – {{ 'demo.title'|trans({}, 'messages') }}{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'examples.page_title'|trans({}, 'messages'),
        intro: 'examples.page_lead'|trans({}, 'messages'),
    }) }}
{% endblock %}

{% block body %}
    <p>
        <a href="{{ 'examples.docs_url'|trans({}, 'messages') }}" rel="noopener noreferrer" target="_blank">{{ 'examples.doc_hub_link'|trans({}, 'messages') }}</a>
    </p>

    {% for section in sections %}
        <h2>{{ section.title|trans({}, 'messages') }}</h2>
        <div class="nowo-ui-cards">
            {% for slug in section.slugs %}
                <section class="nowo-ui-card">
                    <div class="nowo-ui-card__body">
                        {% if slug in liveExampleSlugs %}
                            <span class="nowo-ui-badge nowo-ui-badge--success">{{ 'examples.badge_live'|trans({}, 'messages') }}</span>
                        {% else %}
                            <span class="nowo-ui-badge nowo-ui-badge--neutral">{{ 'examples.badge_stub'|trans({}, 'messages') }}</span>
                        {% endif %}
                        <h3 class="nowo-ui-card__title">{{ ('examples.card.' ~ slug ~ '.title')|trans({}, 'messages') }}</h3>
                        <p class="nowo-ui-muted">{{ ('examples.card.' ~ slug ~ '.desc')|trans({}, 'messages') }}</p>
                        <a class="nowo-ui-btn nowo-ui-btn--outline nowo-ui-btn--sm" href="{{ path('app_examples_show', { _locale: app.request.locale, slug: slug }) }}">{{ 'examples.open'|trans({}, 'messages') }}</a>
                    </div>
                </section>
            {% endfor %}
        </div>
    {% endfor %}
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}{{ 'demo.showcase_page_title'|trans({}, 'messages') }} – {{ 'demo.title'|trans({}, 'messages') }}{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'demo.showcase_page_title'|trans({}, 'messages'),
        intro: 'demo.showcase_page_lead'|trans({}, 'messages'),
    }) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'demo.showcase_page_title'|trans({}, 'messages'), intro: 'tiptap.dev — ' ~ 'demo.showcase_platform_note'|trans({}, 'messages'), kind: 'form', form: form} %}
        {% block section_body %}
            {{ form_start(form, {attr: {id: 'tiptap-showcase-form'}}) }}
                {{ form_errors(form) }}
                {% for name in ['agent', 'notion', 'simple', 'headless'] %}
                    <h3 id="pane-{{ name }}">{{ ('demo.showcase_tab_' ~ name)|trans({}, 'messages') }}</h3>
                    {{ form_row(form['showcase_' ~ name], { label: false }) }}
                {% endfor %}
                {% do form.submit.setRendered %}
                {{ form_rest(form) }}
            {{ form_end(form, {render_rest: false}) }}
        {% endblock %}
        {% block section_footer %}
            <button type="submit" form="tiptap-showcase-form" class="nowo-ui-btn nowo-ui-btn--primary">{{ form.submit.vars.label|trans({}, 'messages') }}</button>
        {% endblock %}
    {% endembed %}

    {% if form.vars.submitted and form.vars.valid %}
        {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'demo.saved_preview'|trans({}, 'messages'), kind: 'detail', form: form} %}
            {% block section_body %}
                {% for name in ['showcase_agent', 'showcase_notion', 'showcase_simple', 'showcase_headless'] %}
                    <h3>{{ form[name].vars.label|trans({}, 'messages') }}</h3>
                    <pre class="nowo-ui-code-block nowo-ui-code-block--wrap">{{ form[name].vars.data|default('')|e }}</pre>
                {% endfor %}
            {% endblock %}
        {% endembed %}
    {% endif %}

    <script src="{{ asset(nowo_tiptap_editor_asset_path('tiptap-editor.js'), nowo_tiptap_editor_asset_package()) }}"></script>
{% endblock %}

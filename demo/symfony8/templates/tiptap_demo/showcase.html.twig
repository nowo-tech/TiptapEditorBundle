{% extends 'base.html.twig' %}

{% block title %}{{ 'demo.showcase_page_title'|trans({}, 'messages') }} – {{ 'demo.title'|trans({}, 'messages') }}{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'demo.showcase_page_title'|trans({}, 'messages'),
        intro: 'demo.showcase_page_lead'|trans({}, 'messages'),
    }) }}
{% endblock %}

{% block body %}
    <p class="nowo-ui-muted"><a href="https://tiptap.dev/" rel="noopener noreferrer" target="_blank">tiptap.dev</a> — {{ 'demo.showcase_platform_note'|trans({}, 'messages') }}</p>

    {{ form_start(form) }}
        {{ form_errors(form) }}
        {% for name in ['agent', 'notion', 'simple', 'headless'] %}
            <section class="nowo-ui-card" id="pane-{{ name }}">
                <div class="nowo-ui-card__body">
                    <h2 class="nowo-ui-card__title">{{ ('demo.showcase_tab_' ~ name)|trans({}, 'messages') }}</h2>
                    {{ form_row(form['showcase_' ~ name], { label: false }) }}
                </div>
            </section>
        {% endfor %}

        {# Each editor lives in its own card (REQ-TWIG-003 rule 3); form_rest renders the submit and the CSRF token. #}
        {{ form_rest(form) }}
    {{ form_end(form, {render_rest: false}) }}

    {% if form.vars.submitted and form.vars.valid %}
        <p class="nowo-ui-muted">{{ 'demo.saved_preview'|trans({}, 'messages') }}</p>
        {% for name in ['showcase_agent', 'showcase_notion', 'showcase_simple', 'showcase_headless'] %}
            <h3>{{ form[name].vars.label|trans({}, 'messages') }}</h3>
            <pre class="nowo-ui-code-block nowo-ui-code-block--wrap">{{ form[name].vars.data|default('')|e }}</pre>
        {% endfor %}
    {% endif %}

    <script src="{{ asset(nowo_tiptap_editor_asset_path('tiptap-editor.js'), nowo_tiptap_editor_asset_package()) }}"></script>
{% endblock %}

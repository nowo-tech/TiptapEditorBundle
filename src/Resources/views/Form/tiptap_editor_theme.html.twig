{#
  Tiptap rich text widget (form_div_layout): `<nowo-tiptap-editor>` host + hidden textarea + mount (HTML synced on change).
  Variant presets (tiptap_variant): default | simple | notion | agent | headless
  Optional examples (tiptap_example): extension recipes — see TiptapExample PHP enum / bundle docs.
  1.7: no inline <style> / style attributes (strict CSP): the widget links `tiptap-editor.css` (asset package
  nowo_tiptap_editor, with the request attribute `csp_nonce` as nonce) unless nowo_tiptap_editor.stylesheet is false;
  the default placeholder key is translated in the NowoTiptapEditorBundle domain (a custom key in the field's domain);
  the toolbar buttons get translated aria-label / title (tiptap_toolbar.*) and, with toolbar_display: icon, icons —
  override the block `tiptap_editor_toolbar_icons` in your form theme to supply your own
  (`<template data-tiptap-icon="bold">{{ ux_icon('tabler:bold') }}</template>`, one per command id).
#}
{% use 'form_div_layout.html.twig' %}

{% block tiptap_editor_widget %}
{% set trans_domain = translation_domain|default('NowoTiptapEditorBundle') %}
{% set ph_key = tiptap_placeholder_key ?? null %}
{% set ph_domain = tiptap_placeholder_domain ?? trans_domain %}
{% set placeholder_text = ph_key is not null and ph_key is not same as(false) and ph_key != '' ? ph_key|trans({}, ph_domain == false ? 'messages' : ph_domain) : '' %}
{% set toolbar_labels = {} %}
{% for command in tiptap_toolbar_commands|default([]) %}
    {% set toolbar_labels = toolbar_labels|merge({(command): ('tiptap_toolbar.' ~ command)|trans({}, 'NowoTiptapEditorBundle')}) %}
{% endfor %}
{% set variant = tiptap_variant|default('default') %}
{% set tiptap_example = tiptap_example|default(null) %}
{% set theme = tiptap_theme|default('light') %}
<nowo-tiptap-editor class="tiptap-editor-widget tiptap-variant-{{ variant|e('html_attr') }} {% if theme == 'auto' %}tiptap-theme-auto{% elseif theme == 'dark' %}tiptap-theme-dark{% else %}tiptap-theme-light{% endif %}"
     data-tiptap-root="1"
     data-controller="{{ ('nowo-tiptap-editor ' ~ (attr['data-controller']|default('')))|trim }}"
     data-tiptap-variant-value="{{ variant|e('html_attr') }}"
     data-tiptap-toolbar-value="{{ tiptap_toolbar ? '1' : '0' }}"
     {% if tiptap_toolbar %}data-tiptap-toolbar-display-value="{{ tiptap_toolbar_display|default('text')|e('html_attr') }}"{% endif %}
     data-tiptap-toolbar-labels-value="{{ toolbar_labels|json_encode|e('html_attr') }}"
     data-tiptap-min-height-value="{{ tiptap_min_height|e('html_attr') }}"
     data-tiptap-debug-value="{{ tiptap_debug ? '1' : '0' }}"
     data-tiptap-theme-value="{{ theme|e('html_attr') }}"
     {% if tiptap_example %}data-tiptap-example-value="{{ tiptap_example|e('html_attr') }}"{% endif %}
     data-tiptap-prompt-link-url-value="{{ 'tiptap_prompt_link_url'|trans({}, 'NowoTiptapEditorBundle')|e('html_attr') }}"
     data-tiptap-prompt-image-url-value="{{ 'tiptap_prompt_image_url'|trans({}, 'NowoTiptapEditorBundle')|e('html_attr') }}"
     data-tiptap-prompt-embed-url-value="{{ 'tiptap_prompt_embed_url'|trans({}, 'NowoTiptapEditorBundle')|e('html_attr') }}"
     {% if tiptap_upload_url|default(null) %}data-tiptap-upload-url-value="{{ tiptap_upload_url|e('html_attr') }}"
     data-tiptap-upload-token-value="{{ tiptap_upload_csrf_token|default('')|e('html_attr') }}"
     data-tiptap-upload-uploading-value="{{ 'tiptap_upload_uploading'|trans({}, 'NowoTiptapEditorBundle')|e('html_attr') }}"
     data-tiptap-upload-uploaded-value="{{ 'tiptap_upload_uploaded'|trans({}, 'NowoTiptapEditorBundle')|e('html_attr') }}"
     data-tiptap-upload-failed-value="{{ 'tiptap_upload_failed'|trans({}, 'NowoTiptapEditorBundle')|e('html_attr') }}"{% endif %}
     {% if tiptap_suggestions|default([]) is not empty %}data-tiptap-suggestions-value="{{ tiptap_suggestions|json_encode|e('html_attr') }}"
     data-tiptap-suggestions-label-value="{{ 'tiptap_suggestions_label'|trans({}, 'NowoTiptapEditorBundle')|e('html_attr') }}"
     data-tiptap-suggestions-empty-value="{{ 'tiptap_suggestions_empty'|trans({}, 'NowoTiptapEditorBundle')|e('html_attr') }}"{% endif %}
     {% if placeholder_text != '' %}data-tiptap-placeholder-value="{{ placeholder_text|e('html_attr') }}"{% endif %}>
    {% set attr = attr|merge({
        class: (attr.class|default('') ~ ' tiptap-editor-hidden-input')|trim,
        hidden: 'hidden',
        tabindex: '-1',
        'aria-hidden': 'true',
    }) %}
    {{- block('textarea_widget') -}}
    {{- block('tiptap_editor_toolbar_icons') -}}
    {% if variant == 'headless' %}
        <div class="tiptap-editor-mount tiptap-headless-mount px-1 py-2" data-tiptap-mount="1"></div>
    {% else %}
        <div class="tiptap-editor-chrome border rounded bg-white shadow-sm">
            <div class="tiptap-editor-mount p-3" data-tiptap-mount="1"></div>
        </div>
    {% endif %}
</nowo-tiptap-editor>
{% if tiptap_stylesheet ?? true %}
    {%- set _tiptap_nonce = nowo_tiptap_editor_csp_nonce() -%}
    <link rel="stylesheet" href="{{ asset(nowo_tiptap_editor_asset_path('tiptap-editor.css'), nowo_tiptap_editor_asset_package()) }}" data-tiptap-stylesheet{% if _tiptap_nonce %} nonce="{{ _tiptap_nonce }}"{% endif %}>
{% endif %}
{% endblock %}

{#- Icon hook (1.7): `<template data-tiptap-icon="<command>">` elements used by toolbar_display: icon instead of the
    built-in SVG (commands: see TiptapEditorType::TOOLBAR_COMMANDS). Empty by default. -#}
{% block tiptap_editor_toolbar_icons %}{% endblock %}
